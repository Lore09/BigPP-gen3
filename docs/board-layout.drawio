                <mxCell id="c1067" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#212121;" value="&lt;b&gt;PLACEMENT&lt;/b&gt; (TL = board top-left corner, mm)" vertex="1">
