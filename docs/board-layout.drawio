                <mxCell id="c1078" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;fontFamily=Helvetica;" value="&lt;table style=&#39;border-collapse:collapse;font-size:10px;width:100%&#39; border=&#39;1&#39; cellpadding=&#39;3&#39;&gt;&lt;tr&gt;&lt;th&gt;#&lt;/th&gt;&lt;th&gt;Net&lt;/th&gt;&lt;th&gt;Connection&lt;/th&gt;&lt;th&gt;Holes&lt;/th&gt;&lt;th&gt;Side&lt;/th&gt;&lt;th&gt;Wire&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;19&lt;/td&gt;&lt;td&gt;+5V&lt;/td&gt;&lt;td&gt;U1 OUT+ riser&lt;/td&gt;&lt;td&gt;N20 → Y20&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;+5V&lt;/td&gt;&lt;td&gt;A1 5V&lt;/td&gt;&lt;td&gt;U12 → Y12&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;21&lt;/td&gt;&lt;td&gt;+5V&lt;/td&gt;&lt;td&gt;J4 VCC&lt;/td&gt;&lt;td&gt;S18 → Y18&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;22&lt;/td&gt;&lt;td&gt;+5V&lt;/td&gt;&lt;td&gt;C1 +&lt;/td&gt;&lt;td&gt;V22 → Y22&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;23&lt;/td&gt;&lt;td&gt;+5V&lt;/td&gt;&lt;td&gt;J3 5V&lt;/td&gt;&lt;td&gt;T31 → Y31&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;24&lt;/td&gt;&lt;td&gt;coil&lt;/td&gt;&lt;td&gt;Q1 C → D1 A → K1 coil&lt;/td&gt;&lt;td&gt;I2 → G2 → G3 → row G → pin&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;runs under U1&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;25&lt;/td&gt;&lt;td&gt;base&lt;/td&gt;&lt;td&gt;Q1 B – R1&lt;/td&gt;&lt;td&gt;I3 – J3&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;solder bridge&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF