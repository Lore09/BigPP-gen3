                <mxCell id="c1077" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;fontFamily=Helvetica;" value="&lt;table style=&#39;border-collapse:collapse;font-size:10px;width:100%&#39; border=&#39;1&#39; cellpadding=&#39;3&#39;&gt;&lt;tr&gt;&lt;th&gt;#&lt;/th&gt;&lt;th&gt;Net&lt;/th&gt;&lt;th&gt;Connection&lt;/th&gt;&lt;th&gt;Holes&lt;/th&gt;&lt;th&gt;Side&lt;/th&gt;&lt;th&gt;Wire&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;+12V&lt;/td&gt;&lt;td&gt;rail&lt;/td&gt;&lt;td&gt;C3 → C31&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;bare ≥0.8 mm (strip current from col 25)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;GND&lt;/td&gt;&lt;td&gt;rail&lt;/td&gt;&lt;td&gt;M1 → M31&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;bare, ≥0.8 mm on cols 30–31&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;+5V&lt;/td&gt;&lt;td&gt;rail&lt;/td&gt;&lt;td&gt;Y1 → Y31&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;bare&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;+12V&lt;/td&gt;&lt;td&gt;J1 +&lt;/td&gt;&lt;td&gt;D31 → C31&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;≥0.8 mm&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;+12V&lt;/td&gt;&lt;td&gt;K1 COM&lt;/td&gt;&lt;td&gt;pin → C25&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;≥0.8 mm&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;+12V&lt;/td&gt;&lt;td&gt;K1 coil&lt;/td&gt;&lt;td&gt;pin → C27&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;+12V&lt;/td&gt;&lt;td&gt;U1 IN+&lt;/td&gt;&lt;td&gt;pad → C5&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;wire leg&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;+12V&lt;/td&gt;&lt;td&gt;D1 cathode&lt;/td&gt;&lt;td&gt;lead in C3&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;lead into the rail&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;GND&lt;/td&gt;&lt;td&gt;J1 −&lt;/td&gt;&lt;td&gt;F31 → F30 → M30&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;≥0.8 mm&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;GND&lt;/td&gt;&lt;td&gt;J2 −&lt;/td&gt;&lt;td&gt;lead in M31&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;pin sits in the rail&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;11&lt;/td&gt;&lt;td&gt;GND&lt;/td&gt;&lt;td&gt;Q1 E&lt;/td&gt;&lt;td&gt;I1 → M1&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;12&lt;/td&gt;&lt;td&gt;GND&lt;/td&gt;&lt;td&gt;U1 IN−&lt;/td&gt;&lt;td&gt;pad → M5&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;wire leg&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;13&lt;/td&gt;&lt;td&gt;GND&lt;/td&gt;&lt;td&gt;U1 OUT−&lt;/td&gt;&lt;td&gt;pad → M20&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;wire leg&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;14&lt;/td&gt;&lt;td&gt;GND&lt;/td&gt;&lt;td&gt;A1 GND&lt;/td&gt;&lt;td&gt;O12 → M12&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;15&lt;/td&gt;&lt;td&gt;GND&lt;/td&gt;&lt;td&gt;J4 GND&lt;/td&gt;&lt;td&gt;P18 → M18&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;16&lt;/td&gt;&lt;td&gt;GND&lt;/td&gt;&lt;td&gt;C1 −&lt;/td&gt;&lt;td&gt;T22 → M22&lt;/td&gt;&lt;td&gt;under&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#FFFFFF&#39;&gt;&lt;td&gt;17&lt;/td&gt;&lt;td&gt;GND&lt;/td&gt;&l